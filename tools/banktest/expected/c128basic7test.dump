FORMAT c128basic7=true
PRE 1c01=10 RGR ELSE DSAVE
PRE 1c0b=20 POT
PRE 1c12=30 BANK
PRE 1c19=35 {$ce}{lgrn} {$fe}{lgrn}
PRE 1c23=37 {$ce}
PRE 1c29=40 PRINT"{$ce}{CTRL-B}{$fe}{CTRL-B}{$cc}"
PRE 1c36=50 REM{$ce}{CTRL-B}{$fe}{CTRL-B}{$cc}"
PRE 1c42=60 SYS 7247
TYPED=true sysFunction=true loadFunction=false
DATA 1c01 pointer16 len=2 1c0b
DATA 1c03 word len=2 10
DATA 1c05 BASIC_V7_TOKEN len=1 RGR
DATA 1c06 PetsciiString len=1 " "
DATA 1c07 BASIC_V7_TOKEN len=1 ELSE
DATA 1c08 PetsciiString len=1 " "
DATA 1c09 BASIC_V7_TOKEN len=1 DSAVE
DATA 1c0a byte len=1 0h
DATA 1c0b pointer16 len=2 1c12
DATA 1c0d word len=2 20
DATA 1c0f byte len=1 CEh
DATA 1c10 BASIC_V7_TOKEN_CE len=1 POT
DATA 1c11 byte len=1 0h
DATA 1c12 pointer16 len=2 1c19
DATA 1c14 word len=2 30
DATA 1c16 byte len=1 FEh
DATA 1c17 BASIC_V7_TOKEN_FE len=1 BANK
DATA 1c18 byte len=1 0h
DATA 1c19 pointer16 len=2 1c23
DATA 1c1b word len=2 35
DATA 1c1d byte len=1 CEh
DATA 1c1e byte len=1 99h
DATA 1c1f PetsciiString len=1 " "
DATA 1c20 byte len=1 FEh
DATA 1c21 byte len=1 99h
DATA 1c22 byte len=1 0h
DATA 1c23 pointer16 len=2 1c29
DATA 1c25 word len=2 37
DATA 1c27 TerminatedPetsciiString len=2 "╱"
DATA 1c29 pointer16 len=2 1c36
DATA 1c2b word len=2 40
DATA 1c2d BASIC_V7_TOKEN len=1 PRINT
DATA 1c2e TerminatedPetsciiString len=8 "\"╱",02h,"▘",02h,"�\""
DATA 1c36 pointer16 len=2 1c42
DATA 1c38 word len=2 50
DATA 1c3a BASIC_V7_TOKEN len=1 REM
DATA 1c3b TerminatedPetsciiString len=7 "╱",02h,"▘",02h,"�\""
