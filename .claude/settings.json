{
  "permissions": {
    "allow": [
      "Bash(bd show *)",
      "Bash(bd recall *)",
      "Bash(bd memories)",
      "Bash(bd memories *)",
      "Bash(bd list *)",
      "Bash(bd ready)",
      "Bash(bd ready *)",
      "Bash(bd prime)",
      "Bash(bd prime *)",
      "Bash(bd search *)",
      "Bash(bd rules audit *)",
      "Bash(bd comments *)",
      "Bash(bd stats)",
      "Bash(bd stats *)",
      "Bash(bd version)",
      "Bash(bd version *)",
      "Bash(git -C \"$GRM_GHIDRA_SRC\" describe --tags)",
      "Bash(git --no-pager diff *)",
      "Bash(tasklist)",
      "Bash(tasklist *)",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "mcp__github__issue_read",
      "mcp__github__list_releases",
      "mcp__github__pull_request_read"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --no-memories"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --no-memories"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "grm-jdtls@grm-local": true,
    "jdtls-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "grm-local": {
      "source": {
        "source": "directory",
        "path": "./.claude/marketplace"
      }
    }
  }
}
