<?xml version="1.0" encoding="UTF-8"?>

<!--
  VENDORED THIRD-PARTY FILE - see NOTICE.

    Upstream: https://github.com/joshleaves/ghidra-snes (carrying achan1989/ghidra-65816)
    Commit:   d33ce5dbfbc3645f00449be1c7ca1c1c65e81756
    Path:     data/languages/65816.cspec
    License:  MIT

  Vendored verbatim at the commit above, with local modifications: this header, the
  __dp_preserved prototype after <default_proto> (a deliberate fork, grm-hf5h.28), and the
  __dbr_preserved / __dp_dbr_preserved prototypes after it (same fork, grm-9nxj.32).
-->

<compiler_spec>
  <global>
    <range space="bus"/>
  </global>
  <stackpointer register="SP" space="bus" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="1" size="2"/>
  </returnaddress>
  <default_proto>
    <prototype name="__unknowncall" extrapop="0" stackshift="0" strategy="register">
      <input/>
      <output/>
    </prototype>
  </default_proto>
  <!--
    grm-hf5h.28 (local addition): the default prototype plus "DP survives the call". Never a
    default: W65816DirectPageAnalyzer assigns it only to functions whose call summary proves DP
    preserved or restored. The decompiler honours a callee's model only when it is locked, which
    Java does for any named convention (FunctionPrototype.grabFromFunction).
  -->
  <prototype name="__dp_preserved" extrapop="0" stackshift="0" strategy="register">
    <input/>
    <output/>
    <unaffected>
      <register name="DP"/>
    </unaffected>
  </prototype>
  <!--
    grm-9nxj.32 (local addition, same fork): the DBR counterparts. ref_data_bank builds every
    absolute operand as (zext(DBR) << 16) + offset, so a call that clobbers DBR leaves every
    later absolute access reading an unknown bank. W65816DataBankAnalyzer assigns these to
    functions whose exit summary proves DBR preserved (__dp_dbr_preserved when the DP analyzer
    proved DP too); __dp_preserved stays DP only. Never a default.
  -->
  <prototype name="__dbr_preserved" extrapop="0" stackshift="0" strategy="register">
    <input/>
    <output/>
    <unaffected>
      <register name="DBR"/>
    </unaffected>
  </prototype>
  <prototype name="__dp_dbr_preserved" extrapop="0" stackshift="0" strategy="register">
    <input/>
    <output/>
    <unaffected>
      <register name="DP"/>
      <register name="DBR"/>
    </unaffected>
  </prototype>
</compiler_spec>
