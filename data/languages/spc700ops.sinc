	$(ZF) = (Y == imm8);
	$(CF) = (Y >= imm8);
}

:CMP Y,ADDR8 is op=0x7E & Y; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1 = Y - tmp;
	
	$(NF) = (result s< 0);
