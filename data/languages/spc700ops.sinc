#======================================================#
# Table C-4: 8-bit Data Transmission Commands,Group 1 #
#======================================================#
:MOV A," #"^imm8 is op=0xE8 & A; imm8 {
	A = imm8;
	
	resultFlags(A);
}

:MOV A,(X) is op=0xE6 & A & X {
	local ptr:2; dpFold(X, ptr);
	A = *:1 ptr;
	
	resultFlags(A);
}

:MOV A,(X)+ is op=0xBF & A & X {
	local ptr:2; dpFold(X, ptr);
	A = *:1 ptr;
	X = X + 1;
	
	resultFlags(A);
}

:MOV A,ADDR8 is op=0xE4 & A; ADDR8 {
	local ptr:2 = ADDR8;
	A = *:1 ptr;
	
	resultFlags(A);
}

:MOV A,ADDR8+X is op=0xF4 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	A = *:1 ptr;
	
	resultFlags(A);
}

:MOV A," !"^ADDR16V is op=0xE5 & A; ADDR16V {
	A = *:1 ADDR16V;
	
	resultFlags(A);
}

:MOV A," !"^ADDR16V+X is op=0xF5 & A & X; ADDR16V {
	local addr:2 = ADDR16V + zext(X);
	A = *:1 addr;
	
	resultFlags(A);
}

:MOV A," !"^ADDR16V+Y is op=0xF6 & A & Y; ADDR16V {
	local addr:2 = ADDR16V + zext(Y);
	A = *:1 addr;
	
	resultFlags(A);
}

:MOV A,[ADDR8+X] is op=0xE7 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local addr:2 = *:2 ptr;
	A = *:1 addr;
	
	resultFlags(A);
}

:MOV A,[ADDR8]+Y is op=0xF7 & A & Y; ADDR8 {
	local ptr:2 = *:2 ADDR8;
	local addr:2 = ptr + zext(Y);
	A = *:1 addr;
	
	resultFlags(A);
}

:MOV X,#^imm8 is op=0xCD & X; imm8 {
	X = imm8;
	
	resultFlags(X);
}

:MOV X,ADDR8 is op=0xF8 & X; ADDR8 {
	X = *:1 ADDR8;
	
	resultFlags(X);
}

:MOV X,ADDR8+Y is op=0xF9 & X & Y; ADDR8 {
	local addr:2; dpIndex(ADDR8, Y, addr);
	X = *:1 addr;
	
	resultFlags(X);
}

:MOV X," !"^ADDR16V is op=0xE9 & X; ADDR16V {
	X = *:1 ADDR16V;
	
	resultFlags(X);
}

:MOV Y," #"^imm8 is op=0x8D & Y; imm8 {
	Y = imm8;
	
	resultFlags(Y);
}

:MOV Y,ADDR8 is op=0xEB & Y; ADDR8 {
	Y = *:1 ADDR8;
	
	resultFlags(Y);
}

:MOV Y,ADDR8+X is op=0xFB & X & Y; ADDR8 {
	local addr:2; dpIndex(ADDR8, X, addr);
	Y = *:1 addr;
	
	resultFlags(Y);
}

:MOV Y," !"^ADDR16V is op=0xEC & Y; ADDR16V {
	Y = *:1 ADDR16V;
	
	resultFlags(Y);
}

#======================================================#
# Table C-5: 8-bit Data Transmission Commands,Group 2 #
#======================================================#
:MOV (X),A is op=0xC6 & A & X {
	local addr:2; dpFold(X, addr);
	*:1 addr = A;
}

:MOV (X)+,A is op=0xAF & A & X {
	local addr:2; dpFold(X, addr);
	X = X + 1;
	*:1 addr = A;
}

:MOV ADDR8,A is op=0xC4 & A; ADDR8 {
	*:1 ADDR8 = A;
}

:MOV ADDR8+X,A is op=0xD4 & A & X; ADDR8{
	local addr:2; dpIndex(ADDR8, X, addr);
	*:1 addr = A;
}

:MOV "!"^ADDR16V,A is op=0xC5 & A; ADDR16V {
	*:1 ADDR16V = A;
}

:MOV "!"^ADDR16V+X,A is op=0xD5 & A & X; ADDR16V {
	local addr:2 = ADDR16V + zext(X);
	*:1 addr = A;
}

:MOV "!"^ADDR16V+Y,A is op=0xD6 & A & Y; ADDR16V {
	local addr:2 = ADDR16V + zext(Y);
	*:1 addr = A;
}

:MOV [ADDR8+X],A is op=0xC7 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local addr:2 = *:2 ptr;
	*:1 addr = A;
}

:MOV [ADDR8]+Y,A is op=0xD7 & A & Y; ADDR8 {
	local ptr:2 = *:2 ADDR8;
	local addr:2 = ptr + zext(Y);
	*:1 addr = A;
}

:MOV ADDR8,X is op=0xD8 & X; ADDR8 {
	local addr:2; dpIndex(ADDR8, X, addr);
	*:1 addr = X;
}

:MOV ADDR8+Y,X is op=0xD9 & X & Y; ADDR8 {
	local addr:2; dpIndex(ADDR8, Y, addr);
	*:1 addr = X;
}

:MOV "!"^ADDR16V,X is op=0xC9 & X; ADDR16V {
	*:1 ADDR16V = X;
}

:MOV ADDR8,Y is op=0xCB & Y; ADDR8 {
	local addr:2; dpIndex(ADDR8, Y, addr);
	*:1 addr = Y;
}

:MOV ADDR8+X,Y is op=0xDB & X & Y; ADDR8 {
	local addr:2; dpIndex(ADDR8, X, addr);
	*:1 addr = Y;
}

:MOV "!"^ADDR16V,Y is op=0xCC & Y; ADDR16V {
	*:1 ADDR16V = Y;
}

#======================================================#
# Table C-6: 8-bit Data Transmission Commands,Group 3 #
#======================================================#
:MOV A,X is op=0x7D & A & X {
	A = X;
	
	resultFlags(A);
}

:MOV A,Y is op=0xDD & A & Y {
	A = Y;
	
	resultFlags(A);
}

:MOV X,A is op=0x5D & A & X {
	X = A;
	
	resultFlags(X);
}

:MOV Y,A is op=0xFD & A & Y {
	Y = A;
	
	resultFlags(Y);
}

:MOV X,SP is op=0x9D & X & SP {
	X = SP:1;
	
	resultFlags(X);
}

:MOV SP,X is op=0xBD & X & SP {
	SP = zext(X);
}

# dstaddr/srcaddr are direct-page offsets like ADDR8, not raw 16-bit addresses -- P-folded the
# same way as the ADC/SBC dstaddr,srcaddr forms in increment 7 (grm-c9d.3 increment 10).
:MOV dstaddr,srcaddr is op=0xFA; srcaddr; dstaddr {
	local src:2; dpFold(srcaddr, src);
	local dst:2; dpFold(dstaddr, dst);
	*:1 dst = *:1 src;
}

:MOV ADDR8," #"^imm8 is op=0x8F; imm8; ADDR8 {
	*:1 ADDR8 = imm8;
}

#======================================================#
# Table C-7: 8-bit Arithmetic Operation Commands       #
#======================================================#
#=ADC=
:ADC A," #"^imm8 is op=0x88 & A; imm8 {
	local result:1;
	aluADC(imm8,result);
	A = result;
}

:ADC A,(X) is op=0x86 & A & X {
	local addr:2; dpFold(X, addr);
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A,ADDR8 is op=0x84 & A; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A,ADDR8+X is op=0x94 & A & X; ADDR8 {
	local addr:2; dpIndex(ADDR8, X, addr);
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A," !"^ADDR16V is op=0x85 & A; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A," !"^ADDR16V+X is op=0x95 & A & X; ADDR16V {
	local addr:2 = ADDR16V + zext(X);
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A," !"^ADDR16V+Y is op=0x96 & A & Y; ADDR16V {
	local addr:2 = ADDR16V + zext(Y);
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A,[ADDR8+X] is op=0x87 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local addr:2 = *:2 ptr;
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC A,[ADDR8]+Y is op=0x97 & A & Y; ADDR8 {
	local ptr:2 = *:2 ADDR8;
	local addr:2 = ptr + zext(Y);
	local tmp:1 = *:1 addr;
	local result:1;
	aluADC(tmp,result);
	A = result;
}

:ADC (X),(Y) is op=0x99 & X & Y {
	local dst:2; dpFold(X, dst);
	local src:2; dpFold(Y, src);
	local acc:1 = *:1 dst;
	local op8:1 = *:1 src;
	local c:1 = $(CF);
	$(HF) = (((acc & 0xF) + (op8 & 0xF) + c) & 0x10) != 0;
	$(CF) = carry(acc, op8);
	local result:1 = acc + op8;
	$(CF) = $(CF) || carry(result, c);
	result = result + c;
	$(VF) = ((acc ^ result) & (op8 ^ result) & 0x80) != 0;
	*:1 dst = result;
	resultFlags(result);
}

# dstaddr/srcaddr are direct-page offsets like ADDR8, not X/Y-indexed -- P-folded the same way
# (grm-c9d.3 increment 7 closes the dp,dp P-fold gap flagged in increment 4, since fixing these
# flagless forms requires touching this exact addressing computation anyway).
:ADC dstaddr,srcaddr is op=0x89; srcaddr; dstaddr {
	local src:2; dpFold(srcaddr, src);
	local dst:2; dpFold(dstaddr, dst);
	local acc:1 = *:1 dst;
	local op8:1 = *:1 src;
	local c:1 = $(CF);
	$(HF) = (((acc & 0xF) + (op8 & 0xF) + c) & 0x10) != 0;
	$(CF) = carry(acc, op8);
	local result:1 = acc + op8;
	$(CF) = $(CF) || carry(result, c);
	result = result + c;
	$(VF) = ((acc ^ result) & (op8 ^ result) & 0x80) != 0;
	*:1 dst = result;
	resultFlags(result);
}

:ADC ADDR8," #"^imm8 is op=0x98; imm8; ADDR8 {
	local acc:1 = *:1 ADDR8;
	local c:1 = $(CF);
	$(HF) = (((acc & 0xF) + (imm8 & 0xF) + c) & 0x10) != 0;
	$(CF) = carry(acc, imm8);
	local result:1 = acc + imm8;
	$(CF) = $(CF) || carry(result, c);
	result = result + c;
	$(VF) = ((acc ^ result) & (imm8 ^ result) & 0x80) != 0;
	*:1 ADDR8 = result;
	resultFlags(result);
}

#=SBC=
:SBC A," #"^imm8 is op=0xA8 & A; imm8 {
	local result:1;
	aluSBC(imm8,result);
	A = result;
}

:SBC A,(X) is op=0xA6 & A & X {
	local addr:2; dpFold(X, addr);
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A,ADDR8 is op=0xA4 & A; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A,ADDR8+X is op=0xB4 & A & X; ADDR8 {
	local addr:2; dpIndex(ADDR8, X, addr);
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A," !"^ADDR16V is op=0xA5 & A; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A," !"^ADDR16V+X is op=0xB5 & A & X; ADDR16V {
	local addr:2 = ADDR16V + zext(X);
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A," !"^ADDR16V+Y is op=0xB6 & A & Y; ADDR16V {
	local addr:2 = ADDR16V + zext(Y);
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A,[ADDR8+X] is op=0xA7 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local addr:2 = *:2 ptr;
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC A,[ADDR8]+Y is op=0xB7 & A & Y; ADDR8 {
	local ptr:2 = *:2 ADDR8;
	local addr:2 = ptr + zext(Y);
	local tmp:1 = *:1 addr;
	local result:1;
	aluSBC(tmp,result);
	A = result;
}

:SBC (X),(Y) is op=0xB9 & X & Y {
	local dst:2; dpFold(X, dst);
	local src:2; dpFold(Y, src);
	local acc:1 = *:1 dst;
	local op8:1 = *:1 src;
	local c:1 = ($(CF) == 0);
	$(HF) = (((acc & 0xF) - (op8 & 0xF) - c) & 0x10) == 0;
	local wideAcc:2 = zext(acc);
	local wideSub:2 = zext(op8) + zext(c);
	$(CF) = wideAcc >= wideSub;
	local result:1 = acc - op8 - c;
	$(VF) = ((acc ^ op8) & (acc ^ result) & 0x80) != 0;
	*:1 dst = result;
	resultFlags(result);
}

# dstaddr/srcaddr P-folded like ADC above (grm-c9d.3 increment 7).
:SBC dstaddr,srcaddr is op=0xA9; srcaddr; dstaddr {
	local src:2; dpFold(srcaddr, src);
	local dst:2; dpFold(dstaddr, dst);
	local acc:1 = *:1 dst;
	local op8:1 = *:1 src;
	local c:1 = ($(CF) == 0);
	$(HF) = (((acc & 0xF) - (op8 & 0xF) - c) & 0x10) == 0;
	local wideAcc:2 = zext(acc);
	local wideSub:2 = zext(op8) + zext(c);
	$(CF) = wideAcc >= wideSub;
	local result:1 = acc - op8 - c;
	$(VF) = ((acc ^ op8) & (acc ^ result) & 0x80) != 0;
	*:1 dst = result;
	resultFlags(result);
}

:SBC ADDR8," #"^imm8 is op=0xB8; imm8; ADDR8 {
	local acc:1 = *:1 ADDR8;
	local operand:1 = imm8;
	local c:1 = ($(CF) == 0);
	$(HF) = (((acc & 0xF) - (operand & 0xF) - c) & 0x10) == 0;
	local wideAcc:2 = zext(acc);
	local wideSub:2 = zext(operand) + zext(c);
	$(CF) = wideAcc >= wideSub;
	local result:1 = acc - operand - c;
	$(VF) = ((acc ^ operand) & (acc ^ result) & 0x80) != 0;
	*:1 ADDR8 = result;
	resultFlags(result);
}

#=CMP=
:CMP A," #"^imm8 is op=0x68 & A; imm8 {
	local result:1 = A - imm8;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == imm8);
	$(CF) = (A >= imm8);
}

:CMP A,(X) is op=0x66 & A & X {
	local ptr:2; dpFold(X, ptr);
	local tmp:1 = *:1 ptr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A,ADDR8 is op=0x64 & A; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A,ADDR8+X is op=0x74 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A," !"^ADDR16V is op=0x65 & A; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A," !"^ADDR16V+X is op=0x75 & A & X; ADDR16V {
	local ptr:2 = ADDR16V + zext(X);
	local tmp:1 = *:1 ptr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A," !"^ADDR16V+Y is op=0x76 & A & Y; ADDR16V {
	local ptr:2 = ADDR16V + zext(Y);
	local tmp:1 = *:1 ptr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A,[ADDR8+X] is op=0x67 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local addr:2 = *:2 ptr;
	local tmp:1 = *:1 addr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP A,[ADDR8]+Y is op=0x77 & A & Y; ADDR8 {
	local ptr:2 = *:2 ADDR8;
	local addr:2 = ptr + zext(Y);
	local tmp:1 = *:1 addr;
	local result:1 = A - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (A == tmp);
	$(CF) = (A >= tmp);
}

:CMP (X),(Y) is op=0x79 & X & Y {
	local dst:2; dpFold(X, dst);
	local src:2; dpFold(Y, src);
	local op1:1 = *:1 dst;
	local op2:1 = *:1 src;
	local result:1 = op1 - op2;
	
	$(NF) = (result s< 0);
	$(ZF) = (op1 == op2);
	$(CF) = (op1 >= op2);
}

# dstaddr/srcaddr P-folded like MOV above (grm-c9d.3 increment 10).
:CMP dstaddr,srcaddr is op=0x69; srcaddr; dstaddr {
	local dst:2; dpFold(dstaddr, dst);
	local src:2; dpFold(srcaddr, src);
	local op1:1 = *:1 dst;
	local op2:1 = *:1 src;
	local result:1 = op1 - op2;
	
	$(NF) = (result s< 0);
	$(ZF) = (op1 == op2);
	$(CF) = (op1 >= op2);
}

:CMP ADDR8," #"^imm8 is op=0x78; imm8; ADDR8 {
	local op1:1 = *:1 ADDR8;
	local result = op1 - imm8;
	
	$(NF) = (result s< 0);
	$(ZF) = (op1 == imm8);
	$(CF) = (op1 >= imm8);
}

:CMP X," #"^imm8 is op=0xC8 & X; imm8 {
	local result:1 = X - imm8;
	
	$(NF) = (result s< 0);
	$(ZF) = (X == imm8);
	$(CF) = (X >= imm8);
}

:CMP X,ADDR8 is op=0x3E & X; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1 = X - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (X == tmp);
	$(CF) = (X >= tmp);
}

:CMP X," !"^ADDR16V is op=0x1E & X; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1 = X - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (X == tmp);
	$(CF) = (X >= tmp);
}

:CMP Y," #"^imm8 is op=0xAD & Y; imm8 {
	local result:1 = Y - imm8;
	
