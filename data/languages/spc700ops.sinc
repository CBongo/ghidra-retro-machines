#======================================================#
# Table C-8: 8-bit Logic Operation Commands            #
#======================================================#
#=AND=
:AND A," #"^imm8 is op=0x28 & A; imm8 {
	local result:1 = A & imm8;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

:AND A,(X) is op=0x26 & A & X {
	local ptr:2; dpFold(X, ptr);
	local tmp:1 = *:1 ptr;
	local result:1 = A & tmp;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

:AND A,ADDR8 is op=0x24 & A; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	local result:1 = A & tmp;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

:AND A,ADDR8+X is op=0x34 & A & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	local result:1 = A & tmp;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

:AND A," !"^ADDR16V is op=0x25 & A; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1 = A & tmp;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

:AND A," !"^ADDR16V+X is op=0x35 & A & X; ADDR16V {
	local ptr:2 = ADDR16V + zext(X);
	local tmp:1 = *:1 ptr;
	local result:1 = A & tmp;
	
	A = result;
	$(NF) = (result s< 0);
	$(ZF) = (result == 0);
}

