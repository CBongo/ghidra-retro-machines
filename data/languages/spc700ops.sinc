#======================================================#
# Table C-9: 8-bit Addition and Subtraction Commands   #
#======================================================#
#=INC=
:INC A is op=0xBC & A { A = A + 1; resultFlags(A); }

:INC ADDR8 is op=0xAB; ADDR8 { local tmp:1 = *:1 ADDR8; tmp = tmp + 1; *:1 ADDR8 = tmp; resultFlags(tmp); }

:INC ADDR8+X is op=0xBB & X; ADDR8 { local addr:2; dpIndex(ADDR8, X, addr); local tmp:1 = *:1 addr; tmp = tmp + 1; *:1 addr = tmp; resultFlags(tmp); }

:INC "!"^ADDR16V is op=0xAC; ADDR16V { local tmp:1 = *:1 ADDR16V; tmp = tmp + 1; *:1 ADDR16V = tmp; resultFlags(tmp); }

:INC X is op=0x3D & X { X = X + 1; resultFlags(X); }

:INC Y is op=0xFC & Y { Y = Y + 1; resultFlags(Y); }

#=DEC=
:DEC A is op=0x9C & A { A = A - 1; resultFlags(A); }

:DEC ADDR8 is op=0x8B; ADDR8 { local tmp:1 = *:1 ADDR8; tmp = tmp - 1; *:1 ADDR8 = tmp; resultFlags(tmp); }

:DEC ADDR8+X is op=0x9B & X; ADDR8 { local addr:2; dpIndex(ADDR8, X, addr); local tmp:1 = *:1 addr; tmp = tmp - 1; *:1 addr = tmp; resultFlags(tmp); }

:DEC "!"^ADDR16V is op=0x8C; ADDR16V { local tmp:1 = *:1 ADDR16V; tmp = tmp - 1; *:1 ADDR16V = tmp; resultFlags(tmp); }

:DEC X is op=0x1D & X { X = X - 1; resultFlags(X); }

:DEC Y is op=0xDC & Y { Y = Y - 1; resultFlags(Y); }

#======================================================#
# Table C-10: Shift Rotation Commands                  #
#======================================================#
#=ASL=
:ASL A is op=0x1C & A {
	$(CF) = (A & 0x80) != 0;
	A = A << 1;
	
	$(NF) = (A s< 0);
	$(ZF) = (A == 0);
}

:ASL ADDR8 is op=0x0B; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	$(CF) = (tmp & 0x80) != 0;
	tmp = tmp << 1;
	*:1 ADDR8 = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ASL ADDR8+X is op=0x1B & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	$(CF) = (tmp & 0x80) != 0;
	tmp = tmp << 1;
	*:1 ptr = tmp;

	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ASL "!"^ADDR16V is op=0x0C; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	$(CF) = (tmp & 0x80) != 0;
	tmp = tmp << 1;
	*:1 ADDR16V = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

#=LSR=
:LSR A is op=0x5C & A {
	$(CF) = (A & 0x01) != 0;
	A = A >> 1;
	
	$(NF) = 0;
	$(ZF) = (A == 0);
}

:LSR ADDR8 is op=0x4B; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	$(CF) = (tmp & 0x01) != 0;
	tmp = tmp >> 1;
	*:1 ADDR8 = tmp;
	
	$(NF) = 0;
	$(ZF) = (tmp == 0);
}

:LSR ADDR8+X is op=0x5B & X; ADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	$(CF) = (tmp & 0x01) != 0;
	tmp = tmp >> 1;
	*:1 ptr = tmp;

	$(NF) = 0;
	$(ZF) = (tmp == 0);
}

:LSR "!"^ADDR16V is op=0x4C; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	$(CF) = (tmp & 0x01) != 0;
	tmp = tmp >> 1;
	*:1 ADDR16V = tmp;
	
	$(NF) = 0;
	$(ZF) = (tmp == 0);
}

#=ROL=
:ROL A is op=0x3C & A {
	local c:1 = $(CF);
	$(CF) = (A & 0x80) != 0;
	A = (A << 1) | c;
	
	$(NF) = (A s< 0);
	$(ZF) = (A == 0);
}

:ROL ADDR8 is op=0x2B; ADDR8 {
	local c:1 = $(CF);
	local tmp:1 = *:1 ADDR8;
	$(CF) = (tmp & 0x80) != 0;
	tmp = (tmp << 1) | c;
	*:1 ADDR8 = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ROL ADDR8+X is op=0x3B & X; ADDR8 {
	local c:1 = $(CF);
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	$(CF) = (tmp & 0x80) != 0;
	tmp = (tmp << 1) | c;
	*:1 ptr = tmp;

	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ROL "!"^ADDR16V is op=0x2C; ADDR16V {
	local c:1 = $(CF);
	local tmp:1 = *:1 ADDR16V;
	$(CF) = (tmp & 0x80) != 0;
	tmp = (tmp << 1) | c;
	*:1 ADDR16V = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

#=ROR=
:ROR A is op=0x7C & A {
	local c:1 = $(CF) << 7;
	$(CF) = (A & 0x01) != 0;
	A = (A >> 1) | c;
	
	$(NF) = (A s< 0);
	$(ZF) = (A == 0);
}

:ROR ADDR8 is op=0x6B; ADDR8 {
	local c:1 = $(CF) << 7;
	local tmp:1 = *:1 ADDR8;
	$(CF) = (tmp & 0x01) != 0;
	tmp = (tmp >> 1) | c;
	*:1 ADDR8 = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ROR ADDR8+X is op=0x7B & X; ADDR8 {
	local c:1 = $(CF) << 7;
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	$(CF) = (tmp & 0x01) != 0;
	tmp = (tmp >> 1) | c;
	*:1 ptr = tmp;

	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

:ROR "!"^ADDR16V is op=0x6C; ADDR16V {
	local c:1 = $(CF) << 7;
	local tmp:1 = *:1 ADDR16V;
	$(CF) = (tmp & 0x01) != 0;
	tmp = (tmp >> 1) | c;
	*:1 ADDR16V = tmp;
	
	$(NF) = (tmp s< 0);
	$(ZF) = (tmp == 0);
}

#=XCN=
:XCN A is op=0x9F & A {
	local tmp:1 = A >> 4;
	A = A << 4 | tmp;
	
	$(NF) = (A s< 0);
	$(ZF) = (A == 0);
}

#======================================================#
# Table C-11: 16-bit Data Transmission Commands        #
#======================================================#
:MOVW YA,ADDR8 is op=0xBA & YA; ADDR8 { local tmp:2; dpWordRead(ADDR8, tmp); YA = tmp; resultFlags(tmp); }

:MOVW ADDR8,YA is op=0xDA & YA; ADDR8 { local tmp:2 = YA; dpWordWrite(ADDR8, tmp); }

#======================================================#
# Table C-12: 16-bit Operation Commands                #
#======================================================#
:INCW ADDR8 is op=0x3A; ADDR8 { local tmp:2; dpWordRead(ADDR8, tmp); tmp = tmp + 1; dpWordWrite(ADDR8, tmp); resultFlags(tmp); }

:DECW ADDR8 is op=0x1A; ADDR8 { local tmp:2; dpWordRead(ADDR8, tmp); tmp = tmp - 1; dpWordWrite(ADDR8, tmp); resultFlags(tmp); }

:ADDW YA,ADDR8 is op=0x7A & YA; ADDR8 {
	local operand:2; dpWordRead(ADDR8, operand);
	local before:2 = YA;
	local wideBefore:4 = zext(before);
	local wideOperand:4 = zext(operand);
	local wideResult:4 = wideBefore + wideOperand;
	$(HF) = (((before & 0xFFF) + (operand & 0xFFF)) & 0x1000) != 0;
	$(CF) = wideResult > 0xFFFF;
	YA = wideResult:2;
	$(VF) = ((before ^ YA) & (operand ^ YA) & 0x8000) != 0;
	resultFlags(YA);
}

:SUBW YA,ADDR8 is op=0x9A & YA; ADDR8 {
	local operand:2; dpWordRead(ADDR8, operand);
	local before:2 = YA;
	$(HF) = (((before & 0xFFF) - (operand & 0xFFF)) & 0x1000) == 0;
	$(CF) = before >= operand;
	YA = before - operand;
	$(VF) = ((before ^ operand) & (before ^ YA) & 0x8000) != 0;
	resultFlags(YA);
}

:CMPW YA,ADDR8 is op=0x5A & YA; ADDR8 {
	local tmp:2; dpWordRead(ADDR8, tmp);
	local result:2 = YA - tmp;
	
	$(NF) = (result s< 0);
	$(ZF) = (YA == tmp);
	$(CF) = (YA >= tmp);
}

#======================================================#
# Table C-13: Multiplication and Division Commands     #
#======================================================#
:MUL YA is op=0xCF & YA { local tmp:2 = zext(Y) * zext(A); YA = tmp; resultFlags(Y); }

:DIV YA,X is op=0x9E & YA & X {
	# NOT FIXED (grm-c9d.3 increment 7): real hardware does NOT do a plain truncating 16/8
	# division here -- it is a documented quirky restoring-division algorithm that produces a
	# DIFFERENT (wrong-looking) quotient/remainder once the true quotient would overflow 8
	# bits, which is common (confirmed against the exhaustive vectors: e.g. Y=0xD1,A=0xAE,X=0x52
	# expects A=0xBC,Y=0x76, not the plain-division A=0x8E,Y=0x32 this body computes). Since A/Y
	# are already wrong in those cases, V/H cannot be verified against them either, so flags are
	# deliberately left unset rather than guessed against an unverifiable baseline -- this needs
	# its own increment implementing the real algorithm, then flags on top of a value that's
	# actually right.
	local dividend:2 = YA;
	local divisor:2 = zext(X);
	local quotient:2 = dividend / divisor;
	local part:2 = quotient * divisor;
	local remainder:2 = dividend - part;
	A = quotient:1;
	Y = remainder:1;
}

#======================================================#
# Table C-14: Decimal Compensation Commands            #
#======================================================#
# DAA/DAS thresholds (grm-c9d.3 increment 9) verified against all 1000 exhaustive vector cases
# each with zero mismatches: BOTH the low-nibble and high-byte adjustment conditions test the
# ORIGINAL A (before either adjustment), even though the low adjustment, if taken, is applied
# to A before the high adjustment runs -- e.g. A=0xFA,C=0,H=0 low-adjusts (low nibble 0xA>9) to
# 0x00, then STILL high-adjusts to 0x60 because the high check uses original A=0xFA>0x99, not
# the already-low-adjusted 0x00. Getting this backwards (checking the post-low-adjust value)
# passes ~976/1000 cases and looks nearly finished, which is why it needed the full 1000 to
# pin down rather than a handful by hand. C is DAS's usual inverted-borrow sense, matching
# CMP/SBC elsewhere in this file.
:DAA A is op=0xDF & A {
	local orig:1 = A;
	local lowCond:1 = ($(HF) == 1) || ((orig & 0xF) > 9);
	if (lowCond == 0) goto <daaSkipLow>;
	A = A + 6;
	<daaSkipLow>
	local highCond:1 = ($(CF) == 1) || (orig > 0x99);
	if (highCond == 0) goto <daaSkipHigh>;
	A = A + 0x60;
	$(CF) = 1;
	<daaSkipHigh>
	resultFlags(A);
}

:DAS A is op=0xBE & A {
	local orig:1 = A;
	local lowCond:1 = ($(HF) == 0) || ((orig & 0xF) > 9);
	if (lowCond == 0) goto <dasSkipLow>;
	A = A - 6;
	<dasSkipLow>
	local highCond:1 = ($(CF) == 0) || (orig > 0x99);
	if (highCond == 0) goto <dasSkipHigh>;
	A = A - 0x60;
	$(CF) = 0;
	<dasSkipHigh>
	resultFlags(A);
}

#======================================================#
# Table C-15: Branching Commands                       #
#======================================================#
:BRA RADDR8 is op=0x2F; RADDR8 { goto RADDR8; }

:BEQ RADDR8 is op=0xF0; RADDR8 { if ($(ZF)==1) goto RADDR8; }

:BNE RADDR8 is op=0xD0; RADDR8 { if ($(ZF)==0) goto RADDR8; }

:BCS RADDR8 is op=0xB0; RADDR8 { if ($(CF)==1) goto RADDR8; }

:BCC RADDR8 is op=0x90; RADDR8 { if ($(CF)==0) goto RADDR8; }

:BVS RADDR8 is op=0x70; RADDR8 { if ($(VF)==1) goto RADDR8; }

:BVC RADDR8 is op=0x50; RADDR8 { if ($(VF)==0) goto RADDR8; }

:BMI RADDR8 is op=0x30; RADDR8 { if ($(NF)==1) goto RADDR8; }

:BPL RADDR8 is op=0x10; RADDR8 { if ($(NF)==0) goto RADDR8; }

:BBS ADDR8^","^aaa,RADDR8 is op_lo=0x3 & bbb=0 & aaa; ADDR8; RADDR8 {
	local tmp:1 = *:1 ADDR8;
	if ((tmp & (1 << aaa)) != 0) goto RADDR8;
}

:BBC ADDR8^","^aaa,RADDR8 is op_lo=0x3 & bbb=4 & aaa; ADDR8; RADDR8 {
	local tmp:1 = *:1 ADDR8;
	if ((tmp & (1 << aaa)) == 0) goto RADDR8;
}

:CBNE ADDR8,RADDR8 is op=0x2E; ADDR8; RADDR8 {
	local tmp:1 = *:1 ADDR8;
	if (A != tmp) goto RADDR8;
}

:CBNE ADDR8+X,RADDR8 is op=0xDE & X; ADDR8; RADDR8 {
	local ptr:2; dpIndex(ADDR8, X, ptr);
	local tmp:1 = *:1 ptr;
	if (A != tmp) goto RADDR8;
}

:DBNZ ADDR8,RADDR8 is op=0x6E; ADDR8; RADDR8 {
	local tmp:1 = *:1 ADDR8;
	tmp = tmp - 1;
	*:1 ADDR8 = tmp;
	if (tmp != 0) goto RADDR8;
}

:DBNZ Y,RADDR8 is op=0xFE & Y; RADDR8 {
	Y = Y - 1;
	if (Y != 0) goto RADDR8;
}

:JMP "!"^ADDR16 is op=0x5F; ADDR16 { goto ADDR16; }

:JMP ["!"^ADDR16V+X] is op=0x1F & X; ADDR16V { local ptr = ADDR16V + zext(X); goto [ptr]; }

#======================================================#
# Table C-16: Subroutine Call,Return Commands         #
#======================================================#
:CALL ADDR16 is op=0x3F; ADDR16 {
	push16(inst_next);
	call ADDR16;
}

:PCALL imm8 is op=0x4F; imm8 {
	push16(inst_next);
	local ptr:2 = 0xFF00 + zext(imm8:1);
	call [ptr];
}

:TCALL op_hi is op_lo=0x1 & op_hi {
	local idx:1 = op_hi + 1;
	local ptr:2 = 0xFFE0 - zext(idx * 2);
	local addr:2 = *:2 ptr;

	push16(inst_next);
	call [addr];
}

:BRK is op=0x0F {
	push16(inst_next);
	push8(PSW);

	$(BF) = 1;
	$(IF) = 0;

	# $FFDE is a VECTOR TABLE entry (like TCALL's $FFC0-$FFDF table), not the handler address
	# itself -- goto [PC] jumps directly to whatever value PC holds, so the table entry must be
	# dereferenced into PC first (confirmed against the vectors: PC ended up AT $FFDE instead of
	# the word stored there, grm-c9d.3 increment 8).
	local vec:2 = 0xFFDE;
	PC = *:2 vec;
	goto [PC];
}

:RET is op=0x6F {
	pop16(PC);
	return [PC];
}

:RETI is op=0x7F {
	# Pop in the REVERSE of BRK's push order: BRK pushes PC then PSW, so PSW is nearer the
	# current SP and must come off FIRST (confirmed against the vectors, grm-c9d.3 increment 8 --
	# popping PC first reads PSW's bytes as part of the address and vice versa).
	pop8(PSW);
	pop16(PC);

	return [PC];
}

#======================================================#
# Table C-17: Stack Operation Commands                 #
#======================================================#
:PUSH A is op=0x2D & A { push8(A); }

:PUSH X is op=0x4D & X { push8(X); }

:PUSH Y is op=0x6D & Y { push8(Y); }

:PUSH PSW is op=0x0D & PSW { push8(PSW); }

:POP A is op=0xAE & A { pop8(A); }

:POP X is op=0xCE & X { pop8(X); }

:POP Y is op=0xEE & Y { pop8(Y); }

:POP PSW is op=0x8E & PSW { pop8(PSW); }

#======================================================#
# Table C-18: Bit Operation Commands                   #
#======================================================#
:SET1 ADDR8^"."aaa is op_lo=0x2 & bbb=0 & aaa; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	tmp = tmp | (1 << aaa);
	*:1 ADDR8 = tmp;
}

:CLR1 ADDR8^"."aaa is op_lo=0x2 & bbb=4 & aaa; ADDR8 {
	local tmp:1 = *:1 ADDR8;
	tmp = tmp & ~(1 << aaa);
	*:1 ADDR8 = tmp;
}

:TSET1 "!"^ADDR16V is op=0x0E; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1 = tmp | A;
	*:1 ADDR16V = result;
	local cmp:1 = A - tmp;
	resultFlags(cmp);
}

:TCLR1 "!"^ADDR16V is op=0x4E; ADDR16V {
	local tmp:1 = *:1 ADDR16V;
	local result:1 = tmp & ~A;
	*:1 ADDR16V = result;
	local cmp:1 = A - tmp;
	resultFlags(cmp);
}

# All six bodies below fixed the SAME class of logic bug the decode-table fix exposed (grm-c9d.3
# increment 10): AND1/OR1/EOR1 tested whether the whole (already-modified) byte was nonzero
# instead of isolating the ORIGINAL value of just the target bit. That meant OR1's `tmp | mask`
# and AND1/OR1's `/` (complement) forms produced a byte that was “nonzero” almost unconditionally,
# so e.g. OR1 C,mem.bit set carry to 1 every time regardless of the bit's actual value. MOV1 and
# NOT1 already isolated/toggled the correct single bit and needed no logic change, only the
# decode fix above.
:AND1 "C," "!"^bitAddr^"."^bitIdx is op=0x4A; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	local bit:1 = (tmp & (1 << bitIdx)) != 0;
	$(CF) = $(CF) & bit;
}

:AND1 "C," "/!"^bitAddr^"."^bitIdx is op=0x6A; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	local bit:1 = (tmp & (1 << bitIdx)) == 0;
	$(CF) = $(CF) & bit;
}

:OR1 "C," "!"^bitAddr^"."^bitIdx is op=0x0A; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	local bit:1 = (tmp & (1 << bitIdx)) != 0;
	$(CF) = $(CF) | bit;
}

:OR1 "C," "/!"^bitAddr^"."^bitIdx is op=0x2A; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	local bit:1 = (tmp & (1 << bitIdx)) == 0;
	$(CF) = $(CF) | bit;
}

:EOR1 "C," "!"^bitAddr^"."^bitIdx is op=0x8A; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	local bit:1 = (tmp & (1 << bitIdx)) != 0;
	$(CF) = $(CF) ^ bit;
}

:NOT1 "!"^bitAddr^"."^bitIdx is op=0xEA; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	tmp = tmp ^ (1 << bitIdx);
	*:1 addr = tmp;
}

:MOV1 "C," "!"^bitAddr^"."^bitIdx is op=0xAA; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	$(CF) = (tmp & (1 << bitIdx)) != 0;
}

:MOV1 "!"^bitAddr^"."^bitIdx^", C" is op=0xCA; bitAddr & bitIdx {
	local addr:2 = bitAddr:2;
	local tmp:1 = *:1 addr;
	tmp = tmp & ~(1 << bitIdx);
	*:1 addr = tmp | ($(CF) << bitIdx);
}

#======================================================#
# Table C-19: Program Status Flag Operation Commands   #
#======================================================#
:CLRC is op=0x60 { $(CF) = 0; }

:SETC is op=0x80 { $(CF) = 1; }

:NOTC is op=0xED { $(CF) = ~$(CF); }

:CLRV is op=0xE0 { $(VF) = 0; $(HF) = 0; }

:CLRP is op=0x20 { $(PF) = 0; }

:SETP is op=0x40 { $(PF) = 1; }

:EI is op=0xA0 { $(IF) = 1; }

:DI is op=0xC0 { $(IF) = 0; }

#======================================================#
# Table C-20: Other Commands                           #
#======================================================#
:NOP is op=0x00 { }

:SLEEP is op=0xEF { sleep(); }

:STOP is op=0xFF { stop(); }