# Common definitions for the SPC700 processor definitions
define endian=little;
define alignment=1;

define space ram     type=ram_space      size=2  default;
define space register type=register_space size=1;

define register offset=0x00 size=2 [ YA _ ];
define register offset=0x00 size=1 [ A Y X PSW ];
define register offset=0x04 size=2 [ PC SP ];

#define 	bitrange CF=PSW[0,1]
#		bitrange ZF=PSW[1,1]
#		bitrange IF=PSW[2,1]
#		bitrange HF=PSW[3,1]
#		bitrange BF=PSW[4,1]
#		bitrange PF=PSW[5,1]
#		bitrange VF=PSW[6,1]
#		bitrange NF=PSW[7,1]
#;
@define CF "PSW[0,1]"
@define ZF "PSW[1,1]"
@define IF "PSW[2,1]"
@define HF "PSW[3,1]"
@define BF "PSW[4,1]"
@define PF "PSW[5,1]"
@define VF "PSW[6,1]"
@define NF "PSW[7,1]"

define token opcode (8)
   op		= (0,7)
   op_hi	= (4,7)
   op_lo	= (0,3)
   aaa		= (5,7)
   bbb		= (2,4)
   cc		= (0,1)
;

define token data8 (8)
   imm8		= (0,7)
   simm8	= (0,7) signed
;

define token movearg (8)
   srcaddr	= (0,7)
   dstaddr	= (0,7)
;

define token data16 (16)
   imm16        = (0,15)
;

# ADDR8 exports the direct-page ADDRESS VALUE (0x0000|dp or 0x0100|dp per the P flag),
# not the byte/word stored there -- constructor bodies in spc700ops.sinc dereference it
# themselves (*:1 ADDR8, *:2 ADDR8, ADDR8 + zext(X), etc). P must be read at runtime
# (SETP/CLRP mutate PSW), so this cannot be folded into a context variable.
ADDR8: 	imm8 	is imm8 	{ local p:1 = $(PF); local lo:2 = zext(imm8:1); local hi:2 = zext(p) << 8; local dpaddr:2 = lo | hi; export dpaddr; }

# ADDR16 (dynamic export) is for control-flow targets ONLY -- goto/call on a dynamic
# export uses the export's ADDRESS (imm16 itself), giving a direct, statically-analyzable
# branch/call. Do not use it for data references or address arithmetic: dereferencing it
# again (*:1 ADDR16) reads the memory AT imm16 instead of imm16 itself.
ADDR16: imm16 	is imm16	{ export *:2 imm16; }

# ADDR16V (value export) is for everything else: data reads/writes and address arithmetic
# (ADDR16V + zext(X)/zext(Y)), where the constructor body needs the numeric address imm16.
# Same match pattern and print piece as ADDR16, so operand display text is identical.
ADDR16V: imm16 	is imm16	{ local absaddr:2 = imm16; export absaddr; }
RADDR8:	addr 	is simm8	[ addr = inst_next + simm8; ] { export *:1 addr; }

define pcodeop daa;
define pcodeop das;
define pcodeop nop;
define pcodeop sleep;
define pcodeop stop;

################################################################
# Macros
################################################################
macro push8(value) {
	SP = SP - 1;
	*:1 (SP) = value;
}

macro pop8(result) {
	result = *:1 (SP);
	SP = SP + 1;
}

macro push16(value) {
	SP = SP - 2;
	*:2 (SP) = value;
}

macro pop16(result) {
	result = *:2 (SP);
	SP = SP + 2;
}

macro resultFlags(value) {
	$(ZF) = (value == 0);
	$(NF) = (value s< 0);
}

macro aluADC(op8, result) {
	local c = $(CF);
	$(NF) = 0;
	$(HF) = (((A & 0xF) + (op8 & 0xF) + c) & 0x10) != 0;
	$(CF) = carry(A, op8);
	result = A + op8;
	$(CF) = $(CF) || carry(result, c);
	result = result + c;
	$(ZF) = (result == 0);
}

macro aluSBC(op8, result) {
	# C is an inverted borrow: C=1 means no borrow occurred. So the incoming
	# borrow-in is (C==0), and the outgoing C is set when A >= op8 + borrowIn
	# (i.e. no borrow at all, computed in one widened comparison rather than
	# the previous two-step approximation).
	local c:1 = ($(CF) == 0);
	local operand:1 = op8;
	$(HF) = (((A & 0xF) - (op8 & 0xF) - c) & 0x10) != 0;
	local wideA:2 = zext(A);
	local wideSub:2 = zext(operand) + zext(c);
	$(CF) = wideA >= wideSub;
	result = A - op8 - c;
	resultFlags(result);
}