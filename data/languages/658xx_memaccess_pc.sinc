#
# This is a FORK POINT, not a re-sync target: bead grm-9nxj.2 changes how immediate
# operands are represented (upstream models them as references dereferenced out of the
# instruction stream, which defeats the constant propagation this project's bank-value
# recovery depends on), so these files diverge permanently once that lands. See
# docs/65816-language-survey.md for the evaluation that led here.
#
# Vendored verbatim at the commit above; the only modification is this header.
# ---------------------------------------------------------------------------------------

# JMP 0x4c - Absolute local.
MemAbsJmp: !$jumpAddress is imm16
    [ jumpAddress = (inst_start $and 0xff0000) $or imm16; ]
{
    export *:3 jumpAddress;
}

# JML 0x5c - Absolute long.
MemAbsLongJmp: !>$imm24 is imm24
{
    export *:3 imm24;
}

# grm-9nxj.4: THE THREE INDIRECT JUMP SUBTABLES BELOW EXPORT A VALUE, NOT `*:3 address`.
# Upstream exported the computed target as a dynamic memory handle and the instructions said
# `goto JMP_OP`, which makes SLEIGH dereference it a SECOND time and then branch to the
# temporary's own address -- generated p-code:
#     (unique,0xf400,3) LOAD (const,0x1f1,4), (unique,0xf300,3)
#      ---  BRANCH (unique,0xf400,3)
# i.e. every indirect jump went to the constant $00F400 regardless of the operand, which is
# exactly what the oracle showed (6C/7C/DC/FC failed 10000 of 10000 cases on PC and PBR).
# Exporting the value and branching with `goto [...]` is the idiom Ghidra's own 6502 uses for
# JMP (abs). The DIRECT forms deliberately keep their `*:3` export so they stay real direct
# branches, which is what gives analysis a static flow edge -- see the split tables in
# 658xx.sinc.

# Absolute indexed by X, indirect.
MemAbsIdxIndJmp: (!$imm16,"X")    is imm16 & IdxX  {
    # Accessing the indirect address must wrap to stay within the bank.
    # Indexing does NOT allow the indirect lookup to cross bank boundaries.
    local offset:2 = imm16 + IdxX;
    local ind_lo_addr:3 = (zext(PBR) << 16) | zext(offset);
    local ind_hi_addr:3 = (zext(PBR) << 16) | zext(offset + 1);

    local addr_lo:1 = *:1 ind_lo_addr;
    local addr_hi:1 = *:1 ind_hi_addr;
    local address:3 = (zext(PBR) << 16) | (zext(addr_hi) << 8) | zext(addr_lo);
    export address;
}

# Absolute indirect.
MemAbsIndJmp: (!$imm16)    is imm16  {
    # Accessing the indirect address must wrap to stay within bank 0.
    local offset:2 = imm16;
    local ind_lo_addr:3 = zext(offset);
    local ind_hi_addr:3 = zext(offset + 1);

    local addr_lo:1 = *:1 ind_lo_addr;
    local addr_hi:1 = *:1 ind_hi_addr;
    local address:3 = (zext(PBR) << 16) | (zext(addr_hi) << 8) | zext(addr_lo);
    export address;
}

# Absolute indirect long.
MemAbsIndLongJmp: [!$imm16]    is imm16  {
    # Accessing the indirect address must wrap to stay within bank 0.
    local offset:2 = imm16;
    local ind_lo_addr:3 = zext(offset);
    local ind_hi_addr:3 = zext(offset + 1);
    local ind_bank_addr:3 = zext(offset + 2);

    local addr_lo:1 = *:1 ind_lo_addr;
    local addr_hi:1 = *:1 ind_hi_addr;
    local addr_bank:1 = *:1 ind_bank_addr;
    local address:3 = (zext(addr_bank) << 16) | (zext(addr_hi) << 8) | zext(addr_lo);
    export address;
}

# PC relative.
# Wraps to stay within the bank of the current instruction.
MemPCRelBra: $reloc    is rel8
    [ reloc = (inst_start $and 0xff0000) $or ((inst_next + rel8) $and 0x00ffff); ]
{
    export *:3 reloc;
}

# PC relative long.
# Wraps to stay within the bank of the current instruction.
MemPCRelLongBra: $reloc    is rel16
    [ reloc = (inst_start $and 0xff0000) $or ((inst_next + rel16) $and 0x00ffff); ]
{
    export *:3 reloc;
}
