# Gradle
.gradle/
build/
dist/

# Generated artifacts — .gdt archives are build output, never committed (see docs/SCHEMA.md)
*.gdt

# Generated runtime map files (JSON, see docs/MAP_FORMAT.md) — build output, never committed
data/machines/*.map

# Compiled per-game descriptors (docs/per-game-descriptors-design.md; bead grm-hb6.3) — build
# output, never committed. Uses .gmap, not .map, so it can never collide with the board-registry
# scan (NesBoardRegistry.scan; bead grm-hb6.10); ignoring the whole directory anyway so the
# first buildExtension after that tier lands doesn't commit build output.
data/games/*

# Generated PETSCII display-string map (JSON, see docs/petscii.md) — build output, never committed
data/petscii.map

# Python bytecode caches (bead grm-r9x). CPython writes these only for modules that are
# IMPORTED, not run as scripts — which is why exactly one ever got committed: the fixture
# generators are all invoked directly, and mkemutest is the only one another generator also
# imports as a module (mkprgloadtest.py, to reuse its build() at a different load address). The
# cached file is derived output whose source is tracked beside it, and its name embeds the
# interpreter version (mkemutest.cpython-313.pyc), so a committed copy is wrong by construction
# for anyone on a different Python. Tracking one meant it showed up modified after every
# generator run and got swept into unrelated commits; its binary hunk also broke `git apply` on
# a patch that had picked it up.
__pycache__/
*.pyc

# Generated C64 screen-code map (JSON, permutation of the PETSCII map) — build output, never committed
data/screencode.map

# Compiled sleigh languages — build output of the sleighCompile task (from the committed
# .slaspec/.sinc sources); regenerated on every build, never committed
data/languages/*.sla

# IDE
.classpath
.project
.settings/
.idea/
bin/

# OS
.DS_Store
Thumbs.db

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Claude Code agent worktrees (transient, per-agent isolated checkouts)
.claude/worktrees/

# Local real-ROM library surveys (tools/banktest/realrom-test.sh nominate output).
# The driver only ever reads manifest.tsv and manifest-gme.tsv, both by hardcoded name, so
# any OTHER manifest-*.tsv is a machine-specific scratch survey of whatever ROM library the
# author happens to have -- useful for finding new test samples or comparing dumps, but not a
# curated, hash-pinned test input and not reproducible for anyone else. Ignored by default;
# re-include explicitly (as manifest-gme.tsv is below) if a survey is ever promoted to a
# curated set.
tools/banktest/realrom/manifest-*.tsv
!tools/banktest/realrom/manifest-gme.tsv
